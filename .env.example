# =============================================================
# CRM WhatsApp — Variables de entorno
# Para la empresa: duplica este fichero como .env y rellena
# los valores con las credenciales de tu propio proyecto Supabase.
# =============================================================

# Supabase — Backend (raíz del proyecto)
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_ANON_KEY=tu_clave_anonima_publica
SUPABASE_SERVICE_ROLE_KEY=tu_clave_secret_service_role
SUPABASE_ACCESS_TOKEN=tu_personal_access_token

# Nota: la SUPABASE_SERVICE_ROLE_KEY tiene permisos completos.
# No expongas esta clave en el frontend ni la compartas sin cifrar.
